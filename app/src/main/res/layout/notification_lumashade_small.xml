<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="62dp"
 android:orientation="horizontal" android:gravity="center_vertical"
 android:paddingLeft="8dp" android:paddingRight="8dp">
 <ImageView android:layout_width="36dp" android:layout_height="36dp"
  android:src="@drawable/ic_lumashade" android:contentDescription="LumaShade"/>
 <TextView android:layout_width="0dp" android:layout_weight="1"
  android:layout_height="wrap_content" android:layout_marginLeft="8dp"
  android:text="LumaShade" android:textSize="14sp" android:textStyle="bold"
  android:textColor="#E8EDF7"/>
 <LinearLayout android:id="@+id/n_small_dim" android:layout_width="62dp"
  android:layout_height="56dp" android:orientation="vertical" android:gravity="center"
  android:contentDescription="Toggle Extra Dim">
  <ImageView android:id="@+id/n_dim_icon" android:layout_width="25dp"
   android:layout_height="25dp" android:src="@drawable/ic_dim_off"/>
  <TextView android:id="@+id/n_dim_caption" android:layout_width="wrap_content"
   android:layout_height="wrap_content" android:text="Dim off"
   android:textColor="#B4BCCD" android:layout_marginTop="2dp" android:textSize="10sp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/n_small_warm" android:layout_width="62dp"
  android:layout_height="56dp" android:orientation="vertical" android:gravity="center"
  android:contentDescription="Toggle blue light filter">
  <ImageView android:id="@+id/n_warm_icon" android:layout_width="25dp"
   android:layout_height="25dp" android:src="@drawable/ic_warm_filter_off"/>
  <TextView android:id="@+id/n_warm_caption" android:layout_width="wrap_content"
   android:layout_height="wrap_content" android:text="Warm off"
   android:textColor="#B4BCCD" android:layout_marginTop="2dp" android:textSize="10sp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/n_small_settings" android:layout_width="54dp"
  android:layout_height="56dp" android:orientation="vertical" android:gravity="center"
  android:contentDescription="Open LumaShade settings">
  <ImageView android:layout_width="25dp" android:layout_height="25dp"
   android:src="@drawable/ic_settings"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="Settings" android:textColor="#B4BCCD"
   android:layout_marginTop="2dp" android:textSize="10sp"/>
 </LinearLayout>
</LinearLayout>