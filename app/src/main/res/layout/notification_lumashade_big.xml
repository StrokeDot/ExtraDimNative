<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notify_panel"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="34dp" android:layout_height="34dp"
            android:src="@drawable/ic_lumashade" android:contentDescription="LumaShade logo"/>
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginLeft="10dp"
            android:text="LumaShade" android:textColor="#F8F9FD"
            android:textStyle="bold" android:textSize="16sp"/>
        <ImageView android:id="@+id/n_settings"
            android:layout_width="38dp" android:layout_height="38dp"
            android:padding="8dp" android:src="@drawable/ic_settings"
            android:contentDescription="Open LumaShade settings"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/n_dim_toggle"
        android:layout_width="match_parent" android:layout_height="36dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Extra Dim"
            android:textSize="14sp" android:textColor="#D3DEFD"/>
        <TextView android:id="@+id/n_dim_state" android:layout_width="45dp"
            android:layout_height="wrap_content" android:gravity="end"
            android:text="Off" android:textSize="13sp" android:textColor="#8BB4FF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Dim intensity"
            android:textSize="12sp" android:textColor="#AAB6CE"/>
        <TextView android:id="@+id/n_dim_value"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="50%" android:textSize="12sp" android:textColor="#8BB4FF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/n_dim_strength1" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Extra Dim intensity 20 percent" />
<ImageView android:id="@+id/n_dim_strength2" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Extra Dim intensity 40 percent" />
<ImageView android:id="@+id/n_dim_strength3" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Extra Dim intensity 60 percent" />
<ImageView android:id="@+id/n_dim_strength4" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Extra Dim intensity 80 percent" />
<ImageView android:id="@+id/n_dim_strength5" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Extra Dim intensity 100 percent" />
    </LinearLayout>
    <LinearLayout android:id="@+id/n_filter_toggle"
        android:layout_width="match_parent" android:layout_height="36dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Blue light filter"
            android:textSize="14sp" android:textColor="#FAE1B2"/>
        <TextView android:id="@+id/n_filter_state"
            android:layout_width="45dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="Off"
            android:textSize="13sp" android:textColor="#F2C277"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Warmth"
            android:textSize="12sp" android:textColor="#AAB6CE"/>
        <TextView android:id="@+id/n_warmth_value"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="50%" android:textSize="12sp" android:textColor="#F2C277"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/n_strength1" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Blue light warmth 20 percent" />
<ImageView android:id="@+id/n_strength2" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Blue light warmth 40 percent" />
<ImageView android:id="@+id/n_strength3" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Blue light warmth 60 percent" />
<ImageView android:id="@+id/n_strength4" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Blue light warmth 80 percent" />
<ImageView android:id="@+id/n_strength5" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="17dp"
            android:layout_marginRight="3dp" android:src="@drawable/bg_segment_off"
            android:contentDescription="Blue light warmth 100 percent" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Tap either bar to adjust • tap a label to switch on/off"
        android:textColor="#9299AB" android:gravity="center" android:textSize="10sp"
        android:paddingTop="4dp"/>
</LinearLayout>