<?xml version="1.0" encoding="utf-8"?>
<!-- The Android notification decor already supplies the single app icon.
     Three equally sized tap targets stay legible in compact and expanded views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="4dp"
    android:paddingRight="4dp">
    <LinearLayout android:id="@+id/n_small_dim"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="60dp" android:gravity="top|center_horizontal"
        android:orientation="vertical" android:paddingTop="5dp" android:contentDescription="Toggle Extra Dim">
        <ImageView android:id="@+id/n_dim_icon"
            android:layout_width="24dp" android:layout_height="24dp"
            android:enabled="false" android:importantForAccessibility="no"
            android:src="@drawable/ic_notify_dim"/>
        <TextView android:id="@+id/n_dim_caption"
            android:layout_width="match_parent" android:layout_height="29dp"
            android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="Dim"
            android:textColor="#8F97A6" android:textSize="11sp"
            android:layout_marginTop="4dp" android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/n_small_warm"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="60dp" android:gravity="top|center_horizontal"
        android:orientation="vertical" android:paddingTop="5dp" android:contentDescription="Toggle blue light filter">
        <ImageView android:id="@+id/n_warm_icon"
            android:layout_width="24dp" android:layout_height="24dp"
            android:enabled="false" android:importantForAccessibility="no"
            android:src="@drawable/ic_notify_warm"/>
        <TextView android:id="@+id/n_warm_caption"
            android:layout_width="match_parent" android:layout_height="29dp"
            android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="Blue light&#10;filter"
            android:textColor="#8F97A6" android:textSize="11sp"
            android:layout_marginTop="4dp" android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/n_small_settings"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="60dp" android:gravity="top|center_horizontal"
        android:orientation="vertical" android:paddingTop="5dp" android:contentDescription="Open LumaShade settings">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_settings"/>
        <TextView android:layout_width="match_parent" android:layout_height="29dp"
            android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="Settings"
            android:textColor="#B4BCCD" android:textSize="11sp"
            android:layout_marginTop="4dp" android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
