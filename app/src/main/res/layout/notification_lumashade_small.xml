<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="40dp"
    android:orientation="horizontal" android:paddingLeft="6dp"
    android:paddingRight="6dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/n_small_logo"
        android:layout_width="32dp" android:layout_height="32dp"
        android:src="@drawable/ic_lumashade" android:contentDescription="LumaShade"/>
    <TextView android:id="@+id/n_small_title"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginLeft="10dp" android:text="LumaShade • Blue light off"
        android:textColor="#E7E9F2" android:textSize="13sp" android:maxLines="1"/>
    <ImageView android:id="@+id/n_small_settings"
        android:layout_width="36dp" android:layout_height="36dp"
        android:padding="7dp" android:src="@drawable/ic_settings"
        android:contentDescription="Open LumaShade settings"/>
</LinearLayout>