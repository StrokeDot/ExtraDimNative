<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_notify_panel"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="40dp" android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_lumashade" android:contentDescription="LumaShade logo"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="10dp"
            android:text="LumaShade" android:textColor="#F6F6FD"
            android:textSize="17sp" android:textStyle="bold"/>
        <ImageView android:id="@+id/n_settings"
            android:layout_width="40dp" android:layout_height="40dp"
            android:padding="8dp" android:src="@drawable/ic_settings"
            android:contentDescription="Open settings"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/n_filter_toggle"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:clickable="true">
        <ImageView android:id="@+id/n_filter_icon"
            android:layout_width="30dp" android:layout_height="30dp"
            android:src="@drawable/ic_warm_filter_off"
            android:contentDescription="Toggle blue light filter"/>
        <TextView android:id="@+id/n_filter_label"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="9dp"
            android:text="Blue light filter" android:textColor="#F5F5FC"
            android:textSize="15sp"/>
        <TextView android:id="@+id/n_filter_state"
            android:layout_width="50dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="Off"
            android:textColor="#F1C382" android:textSize="14sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="26dp" android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Warmth" android:textColor="#CAD1DF" android:textSize="13sp"/>
        <TextView android:id="@+id/n_warmth_value" android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%" android:textColor="#F1C382" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="35dp" android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:id="@+id/n_strength1"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="13dp" android:layout_marginRight="4dp"
            android:src="@drawable/bg_segment_off" android:contentDescription="Warmth 20 percent"/>
        <ImageView android:id="@+id/n_strength2"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="13dp" android:layout_marginRight="4dp"
            android:src="@drawable/bg_segment_off" android:contentDescription="Warmth 40 percent"/>
        <ImageView android:id="@+id/n_strength3"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="13dp" android:layout_marginRight="4dp"
            android:src="@drawable/bg_segment_off" android:contentDescription="Warmth 60 percent"/>
        <ImageView android:id="@+id/n_strength4"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="13dp" android:layout_marginRight="4dp"
            android:src="@drawable/bg_segment_off" android:contentDescription="Warmth 80 percent"/>
        <ImageView android:id="@+id/n_strength5"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="13dp"
            android:src="@drawable/bg_segment_off" android:contentDescription="Warmth 100 percent"/>
    </LinearLayout>
</LinearLayout>